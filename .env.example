# Optional environment variables for local or headless public-API runs.
# Local users do NOT need a .env file: keys can be saved directly in Settings
# (stored locally in ./data/secrets.json with 0600 permissions, gitignored and
# excluded from backups) or provided via this file / shell environment.
# Copy to .env if you prefer env-based configuration (never commit .env!).

# --- Local Storage & Runtime Mode ---
# Runtime mode: "local" (default desktop/Docker UI) or "public" (stateless read-only JSON API)
REALM_MODE=local
# Directory holding knowledge vaults, workspace.json, chats.json, secrets.json (default: ./data)
# REALM_DATA_DIR=/data
# Set to 0 to skip automatic local Ollama embedding during indexing
REALM_AUTO_EMBED=1

# --- Optional Cloud Provider API Keys (alternative to saving in Settings) ---
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# MOONSHOT_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# ELEVENLABS_API_KEY=

# --- Optional Read-Only Public API Mode (REALM_MODE=public) ---
# Comma-separated vault folders under REALM_DATA_DIR to publish read-only
# REALM_PUBLIC_AREAS=my_docs,guides
# Canonical URL template attached to search results, citations, and graph nodes
# REALM_PUBLIC_URL_TEMPLATE=/docs/{area}/{doc_id}
# Allowed browser origins for CORS (comma-separated)
# REALM_PUBLIC_ORIGINS=https://docs.example.com,http://localhost:3000
# Server-locked provider & model for POST /api/public/ask
# REALM_PUBLIC_PROVIDER=kimi
# REALM_PUBLIC_MODEL=kimi-k3.1-pro
# REALM_PUBLIC_REASONING_EFFORT=low
# Per-IP and daily global budget caps (automatically degrades to instant $0 search when reached)
# REALM_PUBLIC_IP_RPM=5
# REALM_PUBLIC_IP_DAILY=25
# REALM_PUBLIC_DAILY_LIMIT=300
# REALM_PUBLIC_DAILY_USD=1.00
