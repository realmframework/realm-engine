# Optional environment variables for local or headless public-API runs.
# Local users do NOT need a .env file: API keys can be saved directly in Settings
# (stored locally in <data_dir>/secrets.json with 0600 permissions, gitignored and
# excluded from ZIP backups) or supplied via this file / shell environment.
# Copy to .env if you prefer env-based configuration (never commit .env!).

# --- Local Storage, Networking & Runtime Mode ---
# Runtime mode: "local" (default desktop/Docker UI) or "public" (stateless read-only JSON API)
REALM_MODE=local
# Directory holding knowledge vaults, workspace.json, chats.json, secrets.json, logs/ (default: ./data)
# REALM_DATA_DIR=/data
# Set to 0 to skip automatic local Ollama embedding during indexing
REALM_AUTO_EMBED=1
# Set to 1 to disable the background vault file watcher
# REALM_DISABLE_WATCHER=0
# Set to 1 ONLY inside trusted containers (Docker) when binding 0.0.0.0 in local mode
# REALM_ALLOW_NON_LOOPBACK=0

# --- Local Ollama Configuration ---
# Override Ollama base URL (loopback required while Strict Local-Only Lock is ON)
# OLLAMA_HOST=http://127.0.0.1:11434
# Set to 1 to allow a non-loopback OLLAMA_HOST (e.g. host.docker.internal) under Local-Only Lock
# REALM_ALLOW_REMOTE_OLLAMA=0
# Optional bearer token if your Ollama endpoint requires authentication
# OLLAMA_API_KEY=

# --- Opt-In Local OpenAI-Compatible API (/v1) & MCP Bridge ---
# Set to 1 to force-enable loopback /v1 endpoints at startup (can also be toggled in Settings -> AI & Voice)
# REALM_ENABLE_LOCAL_API=0
# Optional static bearer token required on /v1/* requests (recommended if sharing localhost)
# REALM_LOCAL_API_TOKEN=
# Optional comma-separated allowlist of areas exposed to `realm-engine mcp` (defaults to all local areas)
# REALM_MCP_AREAS=knowledge_base

# --- Optional Cloud Provider API Keys (alternative to saving in Settings) ---
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# MOONSHOT_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# ELEVENLABS_API_KEY=

# --- Optional Read-Only Public API Mode (REALM_MODE=public) ---
# REQUIRED in public mode: comma-separated vault folders under REALM_DATA_DIR to publish read-only
# REALM_PUBLIC_AREAS=my_docs,guides
# Canonical URL template attached to search results, citations, and graph nodes
# REALM_PUBLIC_URL_TEMPLATE=/docs/{area}/{doc_id}
# Allowed browser origins for CORS (comma-separated)
# REALM_PUBLIC_ORIGINS=https://docs.example.com,http://localhost:3000
# Trusted reverse-proxy IPs allowed to supply X-Forwarded-For (comma-separated, loopback trusted automatically)
# REALM_PUBLIC_TRUSTED_PROXIES=127.0.0.1,::1
# Server-locked provider & model for POST /api/public/ask
# REALM_PUBLIC_PROVIDER=kimi
# REALM_PUBLIC_MODEL=kimi-k3.1-pro
# REALM_PUBLIC_REASONING_EFFORT=low
# Per-IP and daily global budget caps (automatically degrades to instant $0 search when reached)
# REALM_PUBLIC_IP_RPM=5
# REALM_PUBLIC_IP_DAILY=25
# REALM_PUBLIC_DAILY_LIMIT=300
# REALM_PUBLIC_DAILY_USD=1.00
